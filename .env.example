# Local PostgreSQL
DATABASE_URL=postgresql+psycopg://openlivery:openlivery@localhost:5432/openlivery

# Change these keys before using real data (at least 32 characters)
SECRET_KEY=change-this-long-random-key-in-production
ENCRYPTION_KEY=change-this-other-long-random-key

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:3000

# Session cookie flags. Behind HTTPS set COOKIE_SECURE=true. If the frontend and
# API are on different sites, set COOKIE_SAMESITE=none (which requires
# COOKIE_SECURE=true).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Public backend URL used by Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local Baileys bridge. Use the same long random value in FastAPI and Node.
BACKEND_URL=http://localhost:8000
WHATSAPP_BRIDGE_URL=http://localhost:3101
WHATSAPP_BRIDGE_PORT=3101
WHATSAPP_BRIDGE_TOKEN=generate-a-long-random-token-for-the-bridge

# "Typing…" shown before every reply on the Baileys bridge. Length-aware: the
# pause is the message length times MS_PER_CHAR, clamped between MIN and MAX.
# Set MIN and MAX to the same number for a fixed pause. It is added on top of
# the agent's own reply delay, so keep MAX modest.
# WHATSAPP_TYPING_ENABLED=true
# WHATSAPP_TYPING_MS_PER_CHAR=30
# WHATSAPP_TYPING_MIN_MS=1000
# WHATSAPP_TYPING_MAX_MS=4000

# WhatsApp Cloud API (official Meta API). Channel credentials are configured
# per client in the UI; this only overrides the Graph API root (e.g. to pin a
# version or point at a mock in tests).
# META_GRAPH_BASE_URL=https://graph.facebook.com/v23.0

# Startup seeds: JSON files describing an agency, its users, clients and agents,
# applied on a fresh database. Records that already exist are never overwritten.
SEED_ENABLED=true
# Where to read them from (default: apps/api/app/seeds/). Point it at a private
# directory to keep bootstrap data out of the repository.
# SEED_DIR=../../work/seeds
# Re-apply the seeded roles and passwords on every start (recovery switch).
SEED_RESET_PASSWORDS=false
# Override the seeded passwords / store the agency's provider key on first boot.
# SEED_OWNER_PASSWORD=
# SEED_ADMIN_PASSWORD=
# SEED_OPENCODE_GO_API_KEY=
